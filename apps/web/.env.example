# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OneSignal → Settings → Keys & IDs (web push). Optional: push is skipped if empty.
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Set to "true" to force every call through TURN (verifies your relay works).
NEXT_PUBLIC_FORCE_TURN_RELAY=false
