# Same Supabase project as the web app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OneSignal app id (same app as web; iOS + Android platforms configured in OneSignal)
EXPO_PUBLIC_ONESIGNAL_APP_ID=

EXPO_PUBLIC_FORCE_TURN_RELAY=false

# Web app origin (password-reset links open there), e.g. https://us.example.com
EXPO_PUBLIC_WEB_URL=

# Native identifiers used by app.config.ts
IOS_BUNDLE_ID=com.example.us
ANDROID_PACKAGE=com.example.us
# "development" for dev builds, "production" for App Store / TestFlight builds
ONESIGNAL_MODE=development
