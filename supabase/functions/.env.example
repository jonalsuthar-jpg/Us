# Edge Function secrets. Set in production with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# OneSignal → Settings → Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# OneSignal → Settings → Push → Android Notification Channels (create "Messages" and "Calls")
ONESIGNAL_ANDROID_CHANNEL_MESSAGES=
ONESIGNAL_ANDROID_CHANNEL_CALLS=
# Web origin for notification click-through
APP_URL=http://localhost:3000

# TURN — Metered.ca (preferred)
METERED_DOMAIN=yourapp.metered.live
METERED_API_KEY=
# …or any static TURN server
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Phase 3: Fight Translator
ANTHROPIC_API_KEY=
