# Edge Function secrets. Set in production with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# OneSignal → Settings → Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# OneSignal → Settings → Push → Android Notification Channels (create "Messages" and "Calls")
ONESIGNAL_ANDROID_CHANNEL_MESSAGES=
ONESIGNAL_ANDROID_CHANNEL_CALLS=
# Web origin for notification click-through
APP_URL=http://localhost:3000

# TURN — Metered.ca (preferred)
METERED_DOMAIN=yourapp.metered.live
METERED_API_KEY=
# …or any static TURN server
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Phase 3: Fight Translator
ANTHROPIC_API_KEY=

# Snaps cleanup: pg_cron sends this as x-cron-secret. Store the same value in
# Vault as 'cron_secret' (see 20261025000000_snaps.sql).
CRON_SECRET=

# GIPHY API key for the giphy function (GIF and sticker search in chat)
GIPHY_API_KEY=

# Media in Cloudflare R2: the media Worker's URL and the HMAC key it shares
# with the media/chat-video/push functions (workers/media, MEDIA_SIGNING_KEY).
MEDIA_URL=https://us-media.example.workers.dev
MEDIA_SIGNING_KEY=

# Admin emails (new sign-ups waiting for approval) via Resend
RESEND_API_KEY=
ADMIN_EMAIL=
ADMIN_FROM=
